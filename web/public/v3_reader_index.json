{
  "schema_version": 2,
  "title_zh": "法义读本（罗什风通读）",
  "editorial": "篇题为通读新拟，不沿用大正短题；正文由多经罗什风译文熔铸，去重复开经结经。假定：若鸠摩罗什为通读而译阿含，当如是重编，而非逐经照录经目。",
  "chapters": [
    {
      "id": 1,
      "title": "开经·正信",
      "blurb": "先明听法因缘与不坏净信，使心有所归，然后可观法。",
      "sections": [
        "听法因缘",
        "不坏净与四果之基",
        "学处总说"
      ]
    },
    {
      "id": 2,
      "title": "观五蕴",
      "blurb": "色受想行识，皆无常、苦、空、非我。此为阿含观行之枢要。",
      "sections": [
        "五阴无常",
        "五阴是苦",
        "空与非我",
        "厌离与解脱",
        "炽然与出要"
      ]
    },
    {
      "id": 3,
      "title": "观六入",
      "blurb": "眼色、耳声乃至意法，触生受，受生爱。知处、护根，则苦边可尽。",
      "sections": [
        "六入处总观",
        "触受与系缚",
        "护根与离染"
      ]
    },
    {
      "id": 4,
      "title": "观缘起",
      "blurb": "此有故彼有，此灭故彼灭。十二支还灭，是大沙门所说中道。",
      "sections": [
        "缘起法住",
        "十二支流转",
        "还灭与中道"
      ]
    },
    {
      "id": 5,
      "title": "食受谛见",
      "blurb": "明四食、诸受、四谛，并简邪见，令知苦集灭道。",
      "sections": [
        "四食",
        "诸受",
        "四圣谛",
        "断知与离见"
      ]
    },
    {
      "id": 6,
      "title": "修道",
      "blurb": "念处、根力、觉支、八正道、安那般那——道品一贯，如众流归海。",
      "sections": [
        "四念处",
        "五根五力",
        "七觉支",
        "八正道",
        "安那般那念"
      ]
    },
    {
      "id": 7,
      "title": "修证",
      "blurb": "由信而修，由修而证。入流乃至无生，皆不离先所说观与道。",
      "sections": [
        "向果与证果",
        "解脱知見"
      ]
    },
    {
      "id": 8,
      "title": "善说与对机",
      "blurb": "弟子所演、对机问答，取其开决心疑者，以助通读，不求备载诸众。",
      "sections": [
        "舍利弗与目连之说",
        "阿难与质多之问",
        "譬喻与决外道"
      ]
    }
  ],
